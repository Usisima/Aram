{
 "halmos": {
  "titulo": "Teoría intuitiva de los conjuntos",
  "autor": "Paul Halmos",
  "editorial": "",
  "anio": "1960",
  "definiciones": [
   {
    "divisor": "Capítulo 1 · Lo básico"
   },
   {
    "id": "numerable",
    "nombre": "Conjunto numerable",
    "cuerpo": "Un conjunto es numerable cuando se puede poner en correspondencia uno a uno con $\\mathbb{N}$."
   }
  ],
  "demostraciones": [
   {
    "divisor": "Capítulo 2 · Cardinalidad"
   },
   {
    "id": "cantor-diagonal",
    "nombre": "El intervalo no es numerable",
    "general": true,
    "cuerpo": "$[0,1]$ no es numerable.",
    "demostracion": "Suponiendo una lista de todos los reales del intervalo, se construye uno que difiere del $n$-ésimo en su $n$-ésima cifra. Ese número está en el intervalo y no en la lista, así que la lista no los tenía todos."
   },
   {
    "id": "union-numerable",
    "nombre": "Unión numerable de numerables",
    "general": false,
    "cuerpo": "La unión de una familia numerable de conjuntos numerables es numerable.",
    "demostracion": "Se recorren en diagonal, como los racionales. Requiere elección numerable, y por eso se deja aquí y no en la sección general."
   }
  ]
 },
 "spivak": {
  "titulo": "Cálculo infinitesimal",
  "autor": "Michael Spivak",
  "editorial": "2ª ed. Reverté",
  "anio": "1967",
  "definiciones": [],
  "demostraciones": [
   {
    "capitulo": "Prólogo"
   },
   {
    "divisor": "Propiedades básicas de los números"
   },
   {
    "id": "spivak-p1",
    "nombre": "Asociatividad",
    "cuerpo": "$$a + (b + c) = (a + b) + c$$",
    "etiqueta": "P1",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p2",
    "nombre": "Elemento Neutro para la Suma",
    "cuerpo": "$$a + 0 = 0 + a = a$$",
    "etiqueta": "P2",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p3",
    "nombre": "Elemento Inverso para la Suma",
    "cuerpo": "$$a + (-a) = (-a) + a = 0$$",
    "etiqueta": "P3",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p4",
    "nombre": "Conmutatividad para la Suma",
    "cuerpo": "$$a + b = b + a$$",
    "etiqueta": "P4",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p5",
    "nombre": "Asociatividad para la Multiplicación",
    "cuerpo": "$$a \\cdot (b \\cdot c) = (a \\cdot b) \\cdot c$$",
    "etiqueta": "P5",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p6",
    "nombre": "Elemento Neutro para la Multiplicación",
    "cuerpo": "$$a \\cdot 1 = 1 \\cdot a = a, \\quad 1 \\neq 0$$",
    "etiqueta": "P6",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p7",
    "nombre": "Elemento Inverso para la Multiplicación",
    "cuerpo": "$$a \\cdot a^{-1} = a^{-1} \\cdot a = 1, \\quad a \\neq 0$$",
    "etiqueta": "P7",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p8",
    "nombre": "Conmutatividad para la Multiplicación",
    "cuerpo": "$$a \\cdot b = b \\cdot a$$",
    "etiqueta": "P8",
    "tipo": "propiedad"
   },
   {
    "id": "spivak-p9",
    "nombre": "Distributividad",
    "cuerpo": "$$a \\cdot (b + c) = a \\cdot b + a \\cdot c$$",
    "etiqueta": "P9",
    "tipo": "propiedad"
   }
  ]
 },
