{
 "conjuntos": {
  "definiciones": [
   {
    "id": "pertenencia",
    "nombre": "Pertenencia",
    "cuerpo": "        <p>Un conjunto queda determinado por sus elementos: $x \\in A$ dice que $x$ es uno de ellos, y dos conjuntos con los mismos elementos son el mismo.</p>"
   }
  ],
  "teoremas": [
   {
    "divisor": "Funciones"
   },
   {
    "id": "de-morgan",
    "nombre": "Leyes de De Morgan",
    "cuerpo": "$$(A \\cup B)^{c} = A^{c} \\cap B^{c}$$",
    "demostracion": "        <p>Un elemento está fuera de la unión exactamente cuando no está en ninguno de los dos, que es lo mismo que estar en los dos complementos.</p>"
   }
  ],
  "ejercicios": [
   {
    "id": "ej-partes",
    "nombre": "Conjunto de partes",
    "cuerpo": "Prueba que si $A$ tiene $n$ elementos, entonces $\\mathcal{P}(A)$ tiene $2^{n}$.",
    "resolucion": "        <p>Por inducción sobre $n$: al añadir un elemento, cada subconjunto de antes da dos —con él y sin él—, así que la cuenta se dobla.</p>"
   }
  ],
  "libros": [
   {
    "libro": "halmos",
    "papel": "basico"
   }
  ],
  "demostraciones": [
   {
    "divisor": "Cardinalidad"
   },
   "cantor-diagonal"
  ],
  "articulos": [
   {
    "id": "nota-russell",
    "nombre": "Sobre la paradoja de Russell",
    "cuerpo": "        <p>El conjunto de los conjuntos que no se pertenecen a sí mismos no puede existir. Es lo que obliga a que la teoría sea axiomática y no ingenua.</p>"
   }
  ]
 },
